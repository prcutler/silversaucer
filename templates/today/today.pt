<div metal:use-macro="load: ../shared/_layout.pt">
    <div metal:fill-slot="content" tal:omit-tag="True">

<div class="container-fluid bg-dark pt-3 d-flex align-items-center flex-column">

        <div class="page-core">
            <div class="d-flex justify-content-center align-items-center">
                <a class="px-3" href="/today?offset=${ prev_offset }" title="Previous day"><i class="fas fa-arrow-left fa-2x" style="color: #72a4f7;"></i></a>
                <h1 class="mb-0">Albums in your collection released on ${ today_date }</h1>
                <a class="px-3" href="/today?offset=${ next_offset }" title="Next day"><i class="fas fa-arrow-right fa-2x" style="color: #72a4f7;"></i></a>
            </div>


            <table class="table table-hover text-light">
                <p>
                    <tr>
                        <th>Artist Name</th>
                        <th>Album Name</th>
                        <th>Release Date</th>


                    </tr>
                    <span tal:repeat = "e releases">
                        <tr>
                            <td><a href="${e.artist_url}">${e.artist_name}</td>
                            <td><a href="${e.release_url}">${e.release_title}</td>
                            <td>${e.mb_release_date}</td>
                        </tr>
                    </span>
                </p>
            </table>

            <div class="container-fluid bg-dark pt-3 d-flex align-items-center flex-column">
            <p>All <a href="/month" > ${ month } </a> releases</p>
            </div>
        </div>
    </div>
</div>
</div>
